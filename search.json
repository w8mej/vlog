[
  {% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | jsonify }},
    "date": {{ post.date | date: "%B %-d, %Y" | jsonify }},
    "category": {{ post.categories.first | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
